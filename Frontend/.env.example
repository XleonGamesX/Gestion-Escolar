# URL base de la API. Las variables de Vite DEBEN empezar con VITE_ para que
# esten visibles dentro del codigo (import.meta.env.VITE_API_URL).
# Al cambiar este archivo hay que reiniciar "npm run dev".
#
#   Local  -> http://localhost:4500/api   (el backend corre en el puerto 4500)
#   Build de produccion -> NO hace falta definir nada: en src/services/api.js
#   el baseURL es "import.meta.env.VITE_API_URL || /api" y, como el backend
#   sirve el frontend en el mismo dominio, basta "/api".
VITE_API_URL=http://localhost:4500/api
