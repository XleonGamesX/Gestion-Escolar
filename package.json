{
  "name": "gestion-escolar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gestion Escolar: Frontend Vue 3 + Quasar y Backend Express + MongoDB",
  "scripts": {
    "dev": "npm --prefix Frontend run dev",
    "dev:frontend": "npm --prefix Frontend run dev",
